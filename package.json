{
  "name": "global-guidelines-for-a-vibe-coder",
  "version": "1.0.0",
  "private": true,
  "description": "Central repository of AI coding guidelines, templates, and skills",
  "scripts": {
    "audit": "node guidelines/global-configs/scripts/audit-rules.js",
    "check-links": "node guidelines/global-configs/scripts/check-links.js",
    "check-index": "node guidelines/global-configs/scripts/check-index-coverage.js",
    "render:starters": "node guidelines/global-configs/scripts/render-agents-starter.js",
    "render:index": "node guidelines/global-configs/scripts/render-index.js",
    "check-drift": "node guidelines/global-configs/scripts/render-agents-starter.js --check",
    "check-index-drift": "node guidelines/global-configs/scripts/render-index.js --check",
    "render:skills": "node guidelines/global-configs/scripts/render-skills-index.js",
    "check-skills-drift": "node guidelines/global-configs/scripts/render-skills-index.js --check",
    "plan:skills": "node guidelines/global-configs/scripts/plan-skills.js",
    "status:projects": "node guidelines/global-configs/scripts/check-project-freshness.js",
    "sync:all": "node guidelines/global-configs/scripts/sync-all.js",
    "docs:check": "node guidelines/global-configs/scripts/check-docs-freshness.js",
    "docs:census": "node guidelines/global-configs/scripts/check-doc-census.js",
    "guard:gate-wording": "node guidelines/global-configs/scripts/check-gate-wording.js",
    "guard:decisions": "node guidelines/global-configs/scripts/check-decision-index.js",
    "guard:breadth": "node guidelines/global-configs/scripts/check-doc-breadth.js",
    "guard:tiers": "node guidelines/global-configs/scripts/check-guard-tiers.js",
    "new:guideline": "node guidelines/global-configs/scripts/new-guideline.js",
    "new:project": "node guidelines/global-configs/scripts/new-project.js",
    "validate:fast": "npm run check-links && npm run check-index",
    "test:scripts": "node --test guidelines/global-configs/scripts/tests/*.test.js",
    "validate": "npm run audit && npm run check-links && npm run check-index && npm run check-drift && npm run check-index-drift && npm run check-skills-drift && npm run docs:census && npm run guard:tiers && npm run test:scripts",
    "slice:close": "node guidelines/global-configs/scripts/slice-close.js",
    "sync:drift": "node guidelines/global-configs/scripts/check-sync-drift.js",
    "audit:friction": "node guidelines/global-configs/scripts/audit-friction.js"
  },
  "engines": {
    "node": ">=18"
  }
}
